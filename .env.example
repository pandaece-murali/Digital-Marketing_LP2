# Copy these placeholders into .env.local. Never commit real tokens.
# GoHighLevel API Key (or GHL_API_TOKEN) & Location ID:
GHL_API_KEY=
GHL_API_TOKEN=
GHL_LOCATION_ID=

# GoHighLevel Custom Field Keys mapped automatically:
# - contact.what_is_your_primary_goal_for_the_next_36_months (and message)
# - contact.which_services_interested (and service_needed)
# - contact.monthly_marketing_budget (and monthly_marketing_budget)
# - the_decision_maker_for_marketing_services

# Optional alternative: server-to-server HTTPS webhook that accepts the lead JSON.
# GHL takes priority when its two values above are configured.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_BEARER_TOKEN=
