# Copy these placeholders into .env.local. Never commit real tokens.
# GoHighLevel is used when both GHL values are set.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Optional alternative: server-to-server HTTPS webhook that accepts the lead JSON.
# GHL takes priority when its two values above are configured.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_BEARER_TOKEN=
